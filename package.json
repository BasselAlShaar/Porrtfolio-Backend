{
  "name": "portfolio-backend",
  "version": "1.0.0",
  "description": "Backend API for Bassel Al-Shaar's portfolio",
  "keywords": [
    "portfolio",
    "api",
    "express",
    "typescript"
  ],
  "license": "MIT",
  "author": "BasselAlShaar",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:create": "node-pg-migrate create -f migrations.config.json",
    "db:migrate": "node-pg-migrate up -f migrations.config.json",
    "db:rollback": "node-pg-migrate down -f migrations.config.json"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
